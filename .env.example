# Runtime
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://lindy:lindy@localhost:5432/lindy
DATABASE_SSL_MODE=disable
# Optional PEM CA for providers not rooted in the system trust store (use \n escapes in secret managers).
DATABASE_SSL_CA=
MIGRATE_ON_START=false

# Public workflow routing. Create this organization with `npm run admin:create`.
PUBLIC_ORGANIZATION_SLUG=demo-sales
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001,http://127.0.0.1:3001
TRUST_PROXY_HOPS=0

# Generate independent random values of at least 32 characters. Never commit real values.
AUTH_SECRET=replace-with-at-least-32-random-characters
PRIVACY_HASH_SECRET=replace-with-another-32-random-characters
SESSION_TTL_SECONDS=900
COOKIE_SECURE=false

# Abuse controls
INTAKE_RATE_LIMIT=20
INTAKE_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=10

# Bootstrap only; omit after running `npm run admin:create`.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-16-character-password
ADMIN_ORGANIZATION_NAME=Demo Sales
ADMIN_ROLE=ADMIN

# Frontend development only. Production uses the same origin.
VITE_API_BASE_URL=
